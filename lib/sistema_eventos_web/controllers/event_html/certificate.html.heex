<style>
  @media print {
   
    header, nav, footer, .phx-hero, .nao-imprime { 
      display: none !important; 
    }
    
   
    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    
    
    @page { 
      margin: 0; 
      size: landscape; 
    }
    
    
    html, body { 
      background-color: white !important; 
      margin: 0 !important;
      padding: 0 !important;
      height: 100% !important;
      overflow: hidden !important; 
    }

    
    .print-wrapper {
      height: 100% !important;
      padding: 0 !important;
      display: flex;
      align-items: center;
      justify-content: center;
      page-break-after: avoid !important;
      page-break-before: avoid !important;
    }
  }
</style>

<%!-- BOTÃO DE AÇÃO --%>
<div class="text-center my-6 nao-imprime">
  <button 
    onclick="window.print()" 
    class="bg-blue-600 hover:bg-blue-500 text-white px-8 py-3 rounded-lg font-bold shadow-lg transition-all flex items-center justify-center gap-2 mx-auto"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
    </svg>
    Baixar Certificado
  </button>
</div>

<%!-- ÁREA DO CERTIFICADO --%>
<div class="print-wrapper bg-slate-50 py-10 w-full overflow-hidden">
  
  <%!-- Container principal: Tamanho A4, borda azul grossa na esquerda --%>
  <div class="w-[297mm] max-w-full mx-auto bg-white border-l-[24px] border-blue-600 shadow-2xl p-16 relative z-10">
    
    <%!-- Detalhe geométrico no canto superior direito --%>
    <div class="absolute top-0 right-0 w-64 h-64 bg-blue-50 rounded-bl-full -z-10"></div>

    <%!-- Cabeçalho --%>
    <div class="mb-14">
      <h1 class="text-6xl font-black text-slate-800 tracking-tight uppercase">Certificado</h1>
      <p class="text-blue-600 font-bold tracking-widest uppercase mt-2 text-sm">
        De Participação Acadêmica
      </p>
    </div>

    <%!-- Corpo do Texto --%>
    <div class="space-y-8 text-xl text-slate-600 max-w-3xl">
      <p>Conferimos o presente certificado a</p>
      
      <h2 class="text-4xl font-bold text-slate-900 border-b-2 border-blue-100 inline-block pb-2">
        <%= @registration.user.nome || @registration.user.email %>
      </h2>
      
      <p class="leading-relaxed">
        por sua participação no evento <br>
        <strong class="text-2xl text-slate-800 mt-2 block"><%= @registration.event.title %></strong>
      </p>
    </div>

    <%!-- Rodapé (Assinatura e Data) --%>
    <div class="mt-24 flex justify-between items-end border-t-2 border-slate-100 pt-8">
      <div>
        <p class="font-bold text-slate-800 text-lg">Universidade Estadual do Sudoeste da Bahia (UESB)</p>
        <p class="text-slate-500">Sistema de Eventos Acadêmicos</p>
      </div>
      
      <div class="text-right">
        <p class="text-slate-500 mb-1">Data de Emissão</p>
        <p class="font-bold text-slate-800 text-xl"><%= Calendar.strftime(DateTime.utc_now(), "%d/%m/%Y") %></p>
      </div>
    </div>

  </div>
</div>